{
  "name": "voice-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Find an existing TTS voice and a practical tuning recipe from a character image.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark:script": "npm run build && playwright test --config=playwright.benchmark.config.ts",
    "benchmark:archive": "playwright test --config=playwright.archive-benchmark.config.ts",
    "check": "npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "probe:aivis": "tsx server/aivis-probe.ts",
    "probe:elevenlabs": "tsx server/elevenlabs-probe.ts",
    "evaluate:voice": "tsx server/listening-probe.ts",
    "evaluate:vision": "tsx server/vision-evaluation.ts",
    "evaluate:irodori": "tsx server/irodori-probe.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
