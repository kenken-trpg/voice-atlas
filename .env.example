# All services bind to loopback. No API key is needed for manual mode.
PORT=3210
# Install a local vision model first, for example: ollama pull gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Optional. The key stays on the server. Select OpenAI and consent in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Start the VOICEVOX app or engine on this computer for real voice previews.
VOICEVOX_BASE_URL=http://127.0.0.1:50021
